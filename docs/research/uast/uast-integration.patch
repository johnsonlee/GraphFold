+            configuration.kotlinCompilerConfig.put(JVMConfigurationKeys.JDK_HOME, jdk)
+            val project = SourceProject(roots, classpath)
+            configuration.addModules(listOf(UastEnvironment.Module(project, jdk, false, false, false)), emptyList())
+            environment = UastEnvironment.create(configuration)
+            created = environment
+            val kotlinFiles = roots.flatMap { root ->
+                if (root.isFile) listOf(root) else root.walkTopDown().filter { it.isFile }.toList()
+            }.filter { it.extension == "kt" }.distinct()
+            environment.analyzeFiles(kotlinFiles)
+            ready = true
+        } finally {
+            if (!ready) {
+                try {
+                    created?.dispose()
+                } finally {
+                    lock.unlock()
+                }
+            }
+        }
+    }
+
+    fun file(path: Path): UFile {
+        check(!closed) { "UAST session is closed" }
+        val virtual = requireNotNull(environment.coreAppEnv.localFileSystem.findFileByPath(
+            path.toAbsolutePath().normalize().toString(),
+        )) { "Source file does not exist: $path" }
+        val psi = requireNotNull(PsiManager.getInstance(environment.ideaProject).findFile(virtual)) {
+            "No PSI for source file: $path"
+        }
+        return requireNotNull(UastFacade.convertElementWithParent(psi, UFile::class.java) as? UFile) {
+            "No UAST for source file: $path"
+        }
+    }
+
+    override fun close() {
+        if (closed) return
+        closed = true
+        try {
+            environment.dispose()
+        } finally {
+            lock.unlock()
+        }
+    }
+
+    private class SourceProject(roots: List<File>, classpath: List<File>) : Project(
+        LintCliClient("graphfold"), roots.first(), roots.first(),
+    ) {
+        init {
+            javaSourceFolders = roots
+            javaLibraries = classpath
+            nonProvidedJavaLibraries = classpath
+            javaClassFolders = emptyList()
+            testSourceFolders = emptyList()
+            testLibraries = emptyList()
+            directLibraries = emptyList()
+            allLibraries = emptyList()
+            name = "graphfold-source"
+            javaLanguageLevel = LanguageLevel.JDK_17
+            kotlinLanguageLevel = language
+        }
+        override fun isAndroidProject(): Boolean = false
+        override fun isGradleProject(): Boolean = false
+    }
+
+    private companion object {
+        val lock = ReentrantLock()
+        val language = LanguageVersionSettingsImpl(LanguageVersion.KOTLIN_2_1, ApiVersion.KOTLIN_2_1)
+    }
+}
+
+/** The callback must consume UAST before returning; no PSI object may outlive its session. */
+internal fun <T> withParsedSource(text: String, name: String, action: (UFile) -> T): T {
+    val directory = Files.createTempDirectory("graphfold-uast-")
+    try {
+        val source = directory.resolve(Path.of(name).fileName)
+        Files.writeString(source, text)
+        return UastSession(listOf(directory)).use { action(it.file(source)) }
+    } finally {
+        directory.toFile().deleteRecursively()
+    }
+}
