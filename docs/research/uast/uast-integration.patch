+/** Test compilation uses the same pinned, isolated backend as the engine, never Lint's analysis-only compiler. */
+internal fun compileKotlinFixture(source: Path, classes: Path, extraArguments: List<String> = emptyList()) {
+    val compilerDirectory = Files.createDirectories(classes.parent.resolve("fixture-compiler"))
+    val resourceRoot = "/io/johnsonlee/graphfold/engine/compiler/"
+    fun resource(name: String) = requireNotNull(KotlinSourceIndexTest::class.java.getResourceAsStream(resourceRoot + name))
+    val names = resource("classpath.txt").bufferedReader().use { it.readLines() }
+    val classpath = names.map { name ->
+        compilerDirectory.resolve(name).also { destination ->
+            resource(name).use { Files.copy(it, destination, java.nio.file.StandardCopyOption.REPLACE_EXISTING) }
+        }
+    }
+    val dependencies = classpath.filter {
+        it.fileName.toString().startsWith("kotlin-stdlib-") || it.fileName.toString().startsWith("annotations-")
+    }
+    val command = listOf(Path.of(System.getProperty("java.home"), "bin", "java").toString(),
+        "-cp", classpath.joinToString(java.io.File.pathSeparator), "org.jetbrains.kotlin.cli.jvm.K2JVMCompiler",
+        "-no-stdlib", "-no-reflect", "-jvm-target", "17", "-language-version", "2.1", "-api-version", "2.1",
+        "-classpath", dependencies.joinToString(java.io.File.pathSeparator), "-d", classes.toString()) +
+        extraArguments + source.toString()
+    val log = compilerDirectory.resolve("compile.log")
+    val process = ProcessBuilder(command).redirectErrorStream(true).redirectOutput(log.toFile()).start()
+    try {
+        assertTrue(process.waitFor(120, java.util.concurrent.TimeUnit.SECONDS), "Fixture compiler timed out")
+        assertEquals(0, process.exitValue(), Files.readString(log))
+    } finally {
+        if (process.isAlive) process.destroyForcibly()
+    }
