+package io.johnsonlee.graphfold.engine.source
+
+import org.jetbrains.uast.UCallExpression
+import org.jetbrains.uast.visitor.AbstractUastVisitor
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.nio.file.Files
+import java.nio.file.Path
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertNotNull
+import kotlin.test.assertTrue
+
+class UastSessionTest {
+    @TempDir lateinit var root: Path
+
+    @Test fun `module resolves Kotlin calls into Java and retains physical source ranges`() {
+        Files.writeString(root.resolve("Helper.java"), "public class Helper { public static int twice(int x) { return x * 2; } }")
+        val text = "class Consumer { fun apply(x: Int): Int = Helper.twice(x) }"
+        val source = root.resolve("Consumer.kt")
+        Files.writeString(source, text)
+        UastSession(listOf(root)).use { session ->
+            var resolved = false
+            session.file(source).accept(object : AbstractUastVisitor() {
+                override fun visitCallExpression(node: UCallExpression): Boolean {
+                    if (node.methodName == "twice") {
+                        val method = assertNotNull(node.resolve())
+                        assertEquals("Helper", method.containingClass?.qualifiedName)
+                        val psi = assertNotNull(node.sourcePsi)
+                        assertEquals(psi.text, text.substring(psi.textRange.startOffset, psi.textRange.endOffset))
+                        resolved = true
+                    }
+                    return false
+                }
+            })
+            assertTrue(resolved)
+            assertNotNull(session.file(root.resolve("Helper.java")))
+        }
+    }
+
+    @Test fun `closing one session preserves later sessions and prevents stale access`() {
+        val source = root.resolve("Sample.java")
+        Files.writeString(source, "class Sample {}")
+        val session = UastSession(listOf(root))
+        session.file(source)
+        session.close()
+        session.close()
+        assertFailsWith<IllegalStateException> { session.file(source) }
+        UastSession(listOf(root)).use { assertNotNull(it.file(source)) }
+    }
+
+    @Test fun `invalid module initialization releases ownership for a later valid module`() {
+        assertFailsWith<NoSuchElementException> { UastSession(emptyList()) }
+        withParsedSource("class Valid {}", "Valid.java") { assertEquals("Valid", it.classes.single().name) }
+    }
+
+    @Test fun `missing file does not prevent subsequent valid lookup`() {
+        val source = root.resolve("Valid.java")
+        Files.writeString(source, "class Valid {}")
+        UastSession(listOf(root)).use { session ->
+            assertFailsWith<IllegalArgumentException> { session.file(root.resolve("Missing.java")) }
+            assertNotNull(session.file(source))
+        }
+    }
+
+    @Test fun `parallel analyses serialize environment ownership without disposing shared application`() {
+        val executor = Executors.newFixedThreadPool(2)
+        try {
+            val jobs = (1..2).map { n -> executor.submit<String> {
+                withParsedSource("class Sample$n {}", "Sample$n.java") { it.classes.single().name.orEmpty() }
+            } }
+            assertEquals(listOf("Sample1", "Sample2"), jobs.map { it.get(30, TimeUnit.SECONDS) })
+        } finally {
+            executor.shutdownNow()
+        }
+    }
+}
