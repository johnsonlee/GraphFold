+import com.intellij.psi.util.PsiTreeUtil
+import org.jetbrains.kotlin.psi.KtAnonymousInitializer
+import org.jetbrains.kotlin.psi.KtClassOrObject
+import org.jetbrains.kotlin.psi.KtFile
+import org.jetbrains.kotlin.psi.KtNamedDeclaration
+import org.jetbrains.kotlin.psi.KtNamedFunction
+import org.jetbrains.kotlin.psi.KtObjectDeclaration
+import org.jetbrains.kotlin.psi.KtProperty
+import org.jetbrains.uast.UCallExpression
+import org.jetbrains.uast.UClass
+import org.jetbrains.uast.UClassInitializer
+import org.jetbrains.uast.UDeclaration
+import org.jetbrains.uast.UDoWhileExpression
+import org.jetbrains.uast.UElement
+import org.jetbrains.uast.UExpression
+import org.jetbrains.uast.UField
+import org.jetbrains.uast.UForExpression
+import org.jetbrains.uast.UIfExpression
+import org.jetbrains.uast.UMethod
+import org.jetbrains.uast.UPolyadicExpression
+import org.jetbrains.uast.USwitchClauseExpression
+import org.jetbrains.uast.USwitchExpression
+import org.jetbrains.uast.UWhileExpression
+import org.jetbrains.uast.UastBinaryOperator
+import org.jetbrains.uast.visitor.AbstractUastVisitor
+
+/** Shared semantic traversal; physical PSI is used only for syntax identity and exact source spans. */
+internal class AstClassifier {
+    fun facts(source: IndexedSource): List<Fact> = withParsedSource(source.text, source.path) { file ->
+        if (PsiTreeUtil.findChildOfType(file.sourcePsi, PsiErrorElement::class.java) != null) return@withParsedSource emptyList()
+        val facts = mutableListOf<Fact>()
+        val seen = mutableSetOf<String>()
+        file.accept(object : AbstractUastVisitor() {
+            override fun visitElement(node: UElement): Boolean {
+                val psi = node.sourcePsi ?: return false
+                fun add(kind: Kind, name: String, content: String, shape: String = content,
+                    initializer: String? = null, terms: Int = 1, span: PsiElement = psi) {
+                    val key = "$kind:${scope(node)}:$name"
+                    val range = span.textRange
+                    if (seen.add("$key:${range.startOffset}:${range.endOffset}")) {
+                        facts += Fact(kind, key, content, shape, initializer, terms, range.startOffset, range.endOffset)
+                    }
+                }
+                when (node) {
+                    is UField -> {
+                        add(Kind.FIELD, node.name, tokenText(psi), shape(psi), node.uastInitializer?.sourcePsi?.let(::tokenText))
+                        if (isStatic(node, psi)) node.uastInitializer?.sourcePsi?.let {
+                            add(Kind.INITIALIZER, node.name, tokenText(it))
+                        }
+                    }
+                    is UMethod -> if (!node.isConstructor && (psi is PsiMethod || psi is KtNamedFunction)) {
+                        add(Kind.METHOD, signature(node), header(psi), shape(psi))
+                    }
+                    is UClass -> if (psi !is KtFile) add(Kind.TYPE, node.name.orEmpty(), header(psi))
+                    is UClassInitializer -> if (isStatic(node, psi)) {
+                        add(Kind.INITIALIZER, facts.count { it.kind == Kind.INITIALIZER }.toString(), tokenText(psi))
+                    }
+                    is UCallExpression -> add(Kind.CALL, facts.count { it.kind == Kind.CALL }.toString(), tokenText(psi))
+                    else -> conditions(node).forEach { condition ->
+                        condition.sourcePsi?.let {
+                            add(Kind.CONDITION, facts.count { it.kind == Kind.CONDITION }.toString(), tokenText(it),
+                                terms = terms(condition))
+                        }
+                    }
+                }
+                // Kotlin object init blocks are lowered into constructor bodies, not UClassInitializer.
+                val initializer = (psi as? KtAnonymousInitializer) ?: (psi.parent as? KtAnonymousInitializer)
+                if (initializer != null && isStatic(null, initializer)) {
+                    add(Kind.INITIALIZER, "init@${initializer.textRange.startOffset}", tokenText(initializer), span = initializer)
+                }
+                return false
+            }
+        })
+        facts
+    }
+
+    fun canonical(source: IndexedSource): String? = withParsedSource(source.text, source.path) { file ->
+        if (PsiTreeUtil.findChildOfType(file.sourcePsi, PsiErrorElement::class.java) == null) tokenText(file.sourcePsi) else null
+    }
+
+    private fun scope(node: UElement): String = generateSequence(node.uastParent) { it.uastParent }.mapNotNull {
+        when (it) {
+            is UMethod -> if (it.isConstructor) null else signature(it)
+            is UClass -> if (it.sourcePsi is KtFile) null else it.name
+            else -> null
+        }
+    }.toList().reversed().joinToString(".")
+
+    private fun signature(method: UMethod): String = method.name + method.uastParameters.joinToString(
+        prefix = "(", postfix = ")",
+    ) { it.type.canonicalText }
+
+    private fun conditions(node: UElement): List<UExpression> = when (node) {
+        is UIfExpression -> listOf(node.condition)
+        is UWhileExpression -> listOf(node.condition)
+        is UDoWhileExpression -> listOf(node.condition)
+        is UForExpression -> listOfNotNull(node.condition)
+        is USwitchExpression -> listOfNotNull(node.expression)
+        is USwitchClauseExpression -> node.caseValues
+        else -> emptyList()
+    }
+
+    private fun terms(condition: UExpression): Int {
+        var count = 1
+        condition.accept(object : AbstractUastVisitor() {
+            override fun visitElement(node: UElement): Boolean {
+                if (node is UPolyadicExpression &&
+                    (node.operator == UastBinaryOperator.LOGICAL_AND || node.operator == UastBinaryOperator.LOGICAL_OR)) {
+                    count += node.operands.size - 1
+                }
+                return false
+            }
+        })
+        return count
+    }
+
+    private fun isStatic(declaration: UDeclaration?, psi: PsiElement): Boolean = when (psi) {
+        is KtProperty, is KtAnonymousInitializer -> psi.parent is KtFile ||
+            PsiTreeUtil.getParentOfType(psi, KtClassOrObject::class.java) is KtObjectDeclaration
+        else -> declaration?.isStatic == true
+    }
+
+    private fun shape(psi: PsiElement): String {
+        val name = when (psi) {
+            is KtNamedDeclaration -> psi.nameIdentifier
+            is PsiNameIdentifierOwner -> psi.nameIdentifier
+            else -> null
+        }
+        return tokenText(psi, name)
+    }
+
+    private fun header(psi: PsiElement): String {
+        val omitted = when (psi) {
+            is KtNamedFunction -> listOfNotNull(psi.bodyExpression)
+            is KtClassOrObject -> listOfNotNull(psi.body)
+            is PsiMethod -> listOfNotNull(psi.body)
+            is PsiClass -> psi.fields.toList() + psi.methods + psi.innerClasses + psi.initializers
+            else -> emptyList()
+        }.toSet()
+        return tokenText(psi, omitted = omitted)
+    }
+}
+
+private fun tokenText(element: PsiElement, renamed: PsiElement? = null, omitted: Set<PsiElement> = emptySet()): String = when {
+    element is PsiComment || element is PsiWhiteSpace || element in omitted -> ""
+    element === renamed -> "__name"
+    element.firstChild == null -> element.text
+    else -> generateSequence(element.firstChild) { it.nextSibling }.map { tokenText(it, renamed, omitted) }
+        .filter { it.isNotEmpty() }.joinToString(" ")
+}
